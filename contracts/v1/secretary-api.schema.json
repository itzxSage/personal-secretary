{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secretary.invalid/contracts/v1/secretary-api.schema.json",
  "title": "Secretary API Foundation Contract",
  "type": "object",
  "required": ["contract_version"],
  "properties": {
    "contract_version": {
      "const": "1.0.0",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  },
  "$defs": {
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "contract_version", "connectors", "dry_run"],
      "properties": {
        "status": { "const": "ok" },
        "contract_version": { "const": "1.0.0" },
        "connectors": { "const": "disabled" },
        "dry_run": { "const": true }
      }
    },
    "contract_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "expected_version", "received_version"],
          "properties": {
            "code": { "const": "contract_version_mismatch" },
            "expected_version": { "const": "1.0.0" },
            "received_version": { "type": "string" }
          }
        }
      }
    },
    "provider_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_name", "input_fingerprint"],
      "properties": {
        "schema_name": { "type": "string", "minLength": 1 },
        "input_fingerprint": { "type": "string", "minLength": 1 }
      }
    },
    "provider_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_name", "output_json", "provider_version"],
      "properties": {
        "schema_name": { "type": "string", "minLength": 1 },
        "output_json": { "type": "string", "minLength": 1 },
        "provider_version": { "type": "string", "minLength": 1 }
      }
    },
    "transition_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "correlation_id", "occurred_at"],
      "properties": {
        "actor": { "type": "string", "minLength": 1 },
        "correlation_id": { "type": "string", "minLength": 1 },
        "occurred_at": { "type": "string", "format": "date-time" }
      }
    },
    "audit_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "occurred_at", "action_class", "record_kind", "record_id", "actor", "correlation_id", "source_fingerprint", "action_metadata", "previous_hash", "entry_hash"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "occurred_at": { "type": "string", "format": "date-time" },
        "action_class": { "type": "string", "minLength": 1 },
        "record_kind": { "type": "string", "minLength": 1 },
        "record_id": { "type": "string", "format": "uuid" },
        "actor": { "type": "string", "minLength": 1 },
        "correlation_id": { "type": "string", "minLength": 1 },
        "source_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "action_metadata": { "type": "string" },
        "previous_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "entry_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "redacted_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "record_kind", "state", "content_redacted"],
      "properties": {
        "record_id": { "type": "string", "format": "uuid" },
        "record_kind": { "type": "string" },
        "state": { "type": "string" },
        "content_redacted": { "const": true }
      }
    }
  }
}
