<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.personal-secretary.service</string>
    <key>UserName</key>
    <string>_secretary</string>
    <key>ProgramArguments</key>
    <array>
        <string>__REPOSITORY_ROOT__/mac/secretary_service/bin/run</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__REPOSITORY_ROOT__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>SECRETARY_DRY_RUN</key>
        <string>1</string>
        <key>SECRETARY_CONNECTORS</key>
        <string>disabled</string>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>/var/log/personal-secretary.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/personal-secretary.error.log</string>
</dict>
</plist>
